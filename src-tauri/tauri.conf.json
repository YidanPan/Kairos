{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kairos",
  "version": "0.1.0",
  "identifier": "app.kairos.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairos",
        "width": 440,
        "height": 420,
        "minWidth": 320,
        "minHeight": 250,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
